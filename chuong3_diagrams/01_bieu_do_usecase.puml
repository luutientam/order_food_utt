' ==============================================================
' BIỂU ĐỒ USE CASE — App đặt & giao đồ ăn trực tuyến
' Mỗi khối mỗi khối start–end là 1 biểu đồ (đừng dán cả file).
'   <<include>> = bước bắt buộc của use case chính (mũi tên đứt)
'   <<extend>>  = bước tuỳ chọn / mở rộng (mũi tên đứt)
' ==============================================================

' 3.2.3  USE CASE TỔNG QUÁT
@startuml
left to right direction
skinparam linetype polyline
actor "Quản trị viên" as ADMIN
actor "Shipper" as SHIP
rectangle "Hệ thống đặt & giao đồ ăn trực tuyến" {
  usecase "Quản lý món ăn" as UC_FOOD
  usecase "Quản lý nhà hàng & danh mục" as UC_CAT
  usecase "Quản lý đơn hàng" as UC_MORDER
  usecase "Quản lý khuyến mại" as UC_PROMO
  usecase "Quản lý người dùng" as UC_USER
  usecase "Báo cáo & thống kê" as UC_REPORT
  usecase "Xem đơn khả dụng" as UC_AVAIL
  usecase "Nhận đơn" as UC_TAKE
  usecase "Cập nhật trạng thái giao" as UC_DELIVER
  usecase "Xem thu nhập" as UC_EARN
  usecase "Duyệt & tìm món ăn" as UC_BROWSE
  usecase "Quản lý giỏ hàng" as UC_CART
  usecase "Quản lý sổ địa chỉ" as UC_ADDR
  usecase "Đặt hàng" as UC_ORDER
  usecase "Đăng nhập / Đăng xuất" as UC_LOGIN
}
actor "Khách hàng" as KH
ADMIN --> UC_FOOD
ADMIN --> UC_CAT
ADMIN --> UC_MORDER
ADMIN --> UC_PROMO
ADMIN --> UC_USER
ADMIN --> UC_REPORT
SHIP --> UC_AVAIL
SHIP --> UC_TAKE
SHIP --> UC_DELIVER
SHIP --> UC_EARN
KH --> UC_BROWSE
KH --> UC_CART
KH --> UC_ADDR
KH --> UC_ORDER
ADMIN --> UC_LOGIN
SHIP --> UC_LOGIN
KH --> UC_LOGIN
@enduml

' --------------------------------------------------------------
' 3.2.4.1 ĐĂNG NHẬP
' --------------------------------------------------------------
@startuml
skinparam linetype polyline
left to right direction
actor "Khách hàng" as KH
actor "Quản trị viên" as ADMIN
actor "Shipper" as SHIP
usecase "Đăng nhập" as M
usecase "Đăng nhập bằng Google" as UC2
usecase "Quên mật khẩu" as UC3
KH --> M
ADMIN --> M
SHIP --> M
UC2 ..> M : <<extend>>
UC3 ..> M : <<extend>>
@enduml

' --------------------------------------------------------------
' 3.2.4.2 ĐĂNG KÝ TÀI KHOẢN
' --------------------------------------------------------------
@startuml
skinparam linetype polyline
left to right direction
actor "Khách hàng" as KH
usecase "Đăng ký tài khoản" as M
usecase "Nhập thông tin cá nhân" as UC1
usecase "Đăng ký bằng Email" as UC2
usecase "Đăng ký bằng Google" as UC3
KH --> M
M ..> UC1 : <<include>>
UC2 ..> M : <<extend>>
UC3 ..> M : <<extend>>
@enduml

' --------------------------------------------------------------
' 3.2.4.3 QUẢN LÝ SỔ ĐỊA CHỈ
' --------------------------------------------------------------
@startuml
skinparam linetype polyline
left to right direction
actor "Khách hàng" as KH
usecase "Quản lý sổ địa chỉ" as M
usecase "Thêm địa chỉ" as UC1
usecase "Sửa địa chỉ" as UC2
usecase "Xoá địa chỉ" as UC3
usecase "Đặt làm mặc định" as UC4
KH --> M
UC1 ..> M : <<extend>>
UC2 ..> M : <<extend>>
UC3 ..> M : <<extend>>
UC4 ..> M : <<extend>>
@enduml

' --------------------------------------------------------------
' 3.2.4.4 ĐẶT HÀNG
' --------------------------------------------------------------
@startuml
skinparam linetype polyline
left to right direction
actor "Khách hàng" as KH
usecase "Đặt hàng" as M
usecase "Xem giỏ hàng" as UC1
usecase "Chọn địa chỉ giao" as UC2
usecase "Chọn thanh toán" as UC4
usecase "Tạo đơn hàng" as UC5
usecase "Áp dụng khuyến mại" as UC3
usecase "Theo dõi đơn hàng" as UC6
KH --> M
M ..> UC1 : <<include>>
M ..> UC2 : <<include>>
M ..> UC4 : <<include>>
M ..> UC5 : <<include>>
UC3 ..> M : <<extend>>
UC6 ..> M : <<extend>>
@enduml

' --------------------------------------------------------------
' 3.2.4.5 ÁP DỤNG MÃ KHUYẾN MẠI
' --------------------------------------------------------------
