skinparam linetype polyline
left to right direction
actor "Khách hàng" as KH
usecase "Áp dụng khuyến mại" as M
usecase "Nhập mã khi đặt hàng" as UC2
usecase "Áp dụng giảm giá" as UC3
usecase "Xem mã khuyến mại của tôi" as UC1
KH --> M
M ..> UC2 : <<include>>
M ..> UC3 : <<include>>
UC1 ..> M : <<extend>>
@enduml

' --------------------------------------------------------------
' 3.2.4.6 THEO DÕI ĐƠN HÀNG
' --------------------------------------------------------------
