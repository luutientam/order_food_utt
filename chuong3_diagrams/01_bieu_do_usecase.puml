usecase "Đánh giá món ăn (sao + bình luận)" as UC1
usecase "Xem đánh giá của món" as UC2
usecase "Gửi phản hồi dịch vụ" as UC3
KH --> M
UC1 ..> M : <<extend>>
UC2 ..> M : <<extend>>
UC3 ..> M : <<extend>>
@enduml

