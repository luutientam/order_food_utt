<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screenBackground"
    tools:ignore="Autofill">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layout_sign_up"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="?attr/actionBarSize"
            android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/define_dimen_16"
            android:layout_marginEnd="@dimen/define_dimen_16"
            app:cardCornerRadius="@dimen/define_dimen_20"
            app:cardElevation="@dimen/define_dimen_6">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surfaceBackground"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/define_dimen_22"
                android:paddingTop="@dimen/define_dimen_28"
                android:paddingEnd="@dimen/define_dimen_22"
                android:paddingBottom="@dimen/define_dimen_22">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="@dimen/define_dimen_70"
                    android:layout_height="@dimen/define_dimen_70"
                    android:src="@drawable/ic_logo_utt"
                    app:shapeAppearanceOverlay="@style/RoundedCorner20"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/define_dimen_12"
                    android:text="@string/sign_in"
                    android:textColor="@color/neutral900"
                    android:textSize="@dimen/text_size_large"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/define_dimen_4"
                    android:text="@string/app_name"
                    android:textColor="@color/neutral400"
                    android:textSize="@dimen/text_size_xsmall" />

                <EditText
                    android:id="@+id/edt_email"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/define_dimen_50"
                    android:layout_marginTop="@dimen/define_dimen_22"
                    android:background="@drawable/bg_input_field"
                    android:drawablePadding="@dimen/define_dimen_10"
                    android:hint="@string/hint_email"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:paddingStart="@dimen/define_dimen_14"
                    android:paddingEnd="@dimen/define_dimen_14"
                    android:textColor="@color/neutral900"
                    android:textColorHint="@color/neutral400"
                    android:textSize="@dimen/text_size_small" />

                <EditText
                    android:id="@+id/edt_password"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/define_dimen_50"
                    android:layout_marginTop="@dimen/define_dimen_12"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/hint_password"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:paddingStart="@dimen/define_dimen_14"
                    android:paddingEnd="@dimen/define_dimen_14"
                    android:textColor="@color/neutral900"
                    android:textColorHint="@color/neutral400"
                    android:textSize="@dimen/text_size_small" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/define_dimen_18"
                    android:text="@string/user_role"
                    android:textColor="@color/neutral500"
                    android:textSize="@dimen/text_size_xsmall" />

                <RadioGroup
                    android:id="@+id/rg_role"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/define_dimen_4"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rdb_user"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="@color/colorPrimary"
                        android:checked="true"
                        android:text="@string/user"
                        android:textSize="@dimen/text_size_xsmall" />

                    <RadioButton
                        android:id="@+id/rdb_shipper"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="@color/colorPrimary"
                        android:text="@string/shipper"
                        android:textSize="@dimen/text_size_xsmall" />

                    <RadioButton
                        android:id="@+id/rdb_admin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="@color/colorPrimary"
                        android:text="@string/admin"
                        android:textSize="@dimen/text_size_xsmall" />
                </RadioGroup>

                <Button
                    android:id="@+id/btn_sign_in"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/define_dimen_50"
                    android:layout_marginTop="@dimen/define_dimen_22"
                    android:background="@drawable/bg_primary_button"
                    android:stateListAnimator="@null"
                    android:text="@string/sign_in_user"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_normal"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_sign_in_google"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/define_dimen_50"
                    android:layout_marginTop="@dimen/define_dimen_12"
                    android:background="@drawable/bg_google_sign_in"
                    android:drawableStart="@drawable/ic_google"
                    android:drawablePadding="@dimen/define_dimen_12"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.01"
                    android:paddingStart="@dimen/define_dimen_16"
                    android:paddingEnd="@dimen/define_dimen_16"
                    android:stateListAnimator="@null"
                    android:text="@string/sign_in_google"
                    android:textAllCaps="false"
                    android:textColor="@color/google_button_text"
                    android:textSize="@dimen/text_size_small" />

                <TextView
                    android:id="@+id/tv_forgot_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/define_dimen_16"
                    android:padding="@dimen/define_dimen_6"
                    android:text="@string/forgot_password"
                    android:textColor="@color/brandOrange"
                    android:textSize="@dimen/text_size_small"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/layout_sign_up"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/define_dimen_18">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/have_not_account"
            android:textColor="@color/neutral500"
            android:textSize="@dimen/text_size_small" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/define_dimen_6"
            android:text="@string/sign_up"
            android:textColor="@color/brandOrange"
            android:textSize="@dimen/text_size_small"
            android:textStyle="bold" />
    </LinearLayout>
</RelativeLayout>
