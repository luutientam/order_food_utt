<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/define_dimen_16">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/define_dimen_6"
            android:text="@string/hint_name"
            android:textColor="@color/neutral500"
            android:textSize="@dimen/text_size_xsmall" />

        <EditText
            android:id="@+id/edt_name"
            android:layout_width="match_parent"
            android:layout_height="@dimen/define_dimen_50"
            android:background="@drawable/bg_input_field"
            android:hint="@string/hint_name"
            android:paddingStart="@dimen/define_dimen_14"
            android:paddingEnd="@dimen/define_dimen_14"
            android:textColor="@color/neutral900"
            android:textColorHint="@color/neutral400"
            android:textSize="@dimen/text_size_small" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/define_dimen_16"
            android:layout_marginBottom="@dimen/define_dimen_6"
            android:text="@string/feedback_phone"
            android:textColor="@color/neutral500"
            android:textSize="@dimen/text_size_xsmall" />

        <EditText
            android:id="@+id/edt_phone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/define_dimen_50"
            android:background="@drawable/bg_input_field"
            android:hint="@string/feedback_phone"
            android:inputType="phone"
            android:paddingStart="@dimen/define_dimen_14"
            android:paddingEnd="@dimen/define_dimen_14"
            android:textColor="@color/neutral900"
            android:textColorHint="@color/neutral400"
            android:textSize="@dimen/text_size_small" />

        <TextView
            android:id="@+id/tv_save"
            android:layout_width="match_parent"
            android:layout_height="@dimen/define_dimen_50"
            android:layout_marginTop="@dimen/define_dimen_24"
            android:background="@drawable/bg_primary_button"
            android:gravity="center"
            android:text="@string/action_edit"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_normal"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
