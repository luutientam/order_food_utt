<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="560dp"
    tools:viewBindingIgnore="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_surface"
        android:orientation="vertical"
        android:padding="@dimen/define_dimen_20">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/sepay_payment_title"
            android:textColor="@color/neutral800"
            android:textSize="@dimen/text_size_large"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/define_dimen_8"
            android:gravity="center"
            android:text="@string/sepay_scan_hint"
            android:textColor="@color/textColorSecondary"
            android:textSize="@dimen/text_size_xsmall" />

        <ImageView
            android:id="@+id/iv_sepay_qr"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/define_dimen_16"
            android:background="@drawable/bg_white_corner_6_border_gray"
            android:contentDescription="@string/sepay_qr_content_desc"
            android:padding="@dimen/define_dimen_8"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tv_sepay_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/define_dimen_12"
            android:textColor="@color/priceColor"
            android:textSize="@dimen/text_size_xlarge"
            android:textStyle="bold"
            tools:text="32.000đ" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/define_dimen_16"
            android:background="@drawable/bg_input_field"
            android:orientation="vertical"
            android:padding="@dimen/define_dimen_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sepay_bank_label"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="@dimen/text_size_small" />

                <TextView
                    android:id="@+id/tv_sepay_bank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/neutral800"
                    android:textSize="@dimen/text_size_small"
                    android:textStyle="bold"
                    tools:text="TPBank" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/define_dimen_8"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sepay_account_label"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="@dimen/text_size_small" />

                <TextView
                    android:id="@+id/tv_sepay_account"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/neutral800"
                    android:textSize="@dimen/text_size_small"
                    android:textStyle="bold"
                    tools:text="0337993739" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/define_dimen_8"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sepay_holder_label"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="@dimen/text_size_small" />

                <TextView
                    android:id="@+id/tv_sepay_holder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/neutral800"
                    android:textSize="@dimen/text_size_small"
                    android:textStyle="bold"
                    tools:text="LUU TIEN TAM" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/define_dimen_8"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sepay_content_label"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="@dimen/text_size_small" />

                <TextView
                    android:id="@+id/tv_sepay_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/brandOrange"
                    android:textSize="@dimen/text_size_small"
                    android:textStyle="bold"
                    tools:text="UTT123456" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/define_dimen_16"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/progress_sepay"
                android:layout_width="@dimen/define_dimen_20"
                android:layout_height="@dimen/define_dimen_20"
                android:layout_marginEnd="@dimen/define_dimen_8" />

            <TextView
                android:id="@+id/tv_sepay_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sepay_waiting"
                android:textColor="@color/textColorSecondary"
                android:textSize="@dimen/text_size_small" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/define_dimen_20"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_sepay_cancel"
                android:layout_width="0dp"
                android:layout_height="@dimen/define_dimen_48"
                android:layout_marginEnd="@dimen/define_dimen_10"
                android:layout_weight="1"
                android:background="@drawable/bg_outlined_button"
                android:gravity="center"
                android:text="@string/sepay_cancel_order"
                android:textColor="@color/brandOrange"
                android:textSize="@dimen/text_size_small"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sepay_paid"
                android:layout_width="0dp"
                android:layout_height="@dimen/define_dimen_48"
                android:layout_weight="1"
                android:background="@drawable/bg_primary_button"
                android:gravity="center"
                android:text="@string/sepay_close"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_small"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
