<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/define_dimen_20">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rating_dialog_hint"
        android:textColor="@color/neutral800"
        android:textSize="@dimen/text_size_normal"
        android:textStyle="bold" />

    <RatingBar
        android:id="@+id/rating_bar"
        style="?android:attr/ratingBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/define_dimen_12"
        android:numStars="5"
        android:progressTint="@color/ratingStar"
        android:rating="5"
        android:stepSize="1" />

    <EditText
        android:id="@+id/edt_review_comment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/define_dimen_16"
        android:background="@drawable/bg_input_field"
        android:gravity="top"
        android:hint="@string/rating_comment_hint"
        android:inputType="textMultiLine|textCapSentences"
        android:minHeight="@dimen/define_dimen_80"
        android:padding="@dimen/define_dimen_12"
        android:textColorHint="@color/neutral400"
        android:textSize="@dimen/text_size_small" />
</LinearLayout>
