<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screenBackground">

    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar" />

    <!-- Sticky bottom CTA bar -->
    <LinearLayout
        android:id="@+id/layout_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/surfaceBackground"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/define_dimen_16"
        android:paddingTop="@dimen/define_dimen_10"
        android:paddingEnd="@dimen/define_dimen_16"
        android:paddingBottom="@dimen/define_dimen_12">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="@dimen/define_dimen_10"
            android:background="@color/neutral100" />

        <TextView
            android:id="@+id/tv_add_to_cart"
            android:layout_width="match_parent"
            android:layout_height="@dimen/define_dimen_50"
            android:background="@drawable/bg_primary_button"
            android:gravity="center"
            android:text="@string/add_to_cart"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_normal"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layout_bottom_bar"
        android:layout_below="@+id/toolbar"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surfaceBackground">

                <com.utt.foodorderapp.widget.AspectRatioNoRadiusImageView
                    android:id="@+id/image_food"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/neutral100"
                    android:scaleType="centerCrop"
                    app:aspectRatio="0.56"
                    app:aspectRatioEnabled="true"
                    app:dominantMeasurement="Width" />

                <TextView
                    android:id="@+id/tv_sale_off"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_margin="@dimen/define_dimen_12"
                    android:background="@drawable/bg_badge_sale"
                    android:paddingStart="@dimen/define_dimen_10"
                    android:paddingTop="@dimen/define_dimen_4"
                    android:paddingEnd="@dimen/define_dimen_10"
                    android:paddingBottom="@dimen/define_dimen_4"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_xsmall"
                    android:textStyle="bold"
                    tools:ignore="RelativeOverlap"
                    tools:text="Giảm 20%" />
            </RelativeLayout>

            <!-- Info card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surfaceBackground"
                android:orientation="vertical"
                android:paddingStart="@dimen/define_dimen_16"
                android:paddingTop="@dimen/define_dimen_16"
                android:paddingEnd="@dimen/define_dimen_16"
                android:paddingBottom="@dimen/define_dimen_16">

                <TextView
                    android:id="@+id/tv_food_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/neutral900"
                    android:textSize="@dimen/text_size_large"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/define_dimen_6"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_star_filled"
                        app:tint="@color/ratingStar"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/tv_food_rating_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textColor="@color/neutral800"
                        android:textSize="@dimen/text_size_small"
                        android:textStyle="bold"
                        tools:text="4.8" />

                    <TextView
                        android:id="@+id/tv_food_sold_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/define_dimen_8"
                        android:textColor="@color/neutral500"
                        android:textSize="@dimen/text_size_xsmall"
                        tools:text="Đã bán 1.2k" />
                </LinearLayout>

                <!-- Price block -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/define_dimen_12"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_price_sale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/priceColor"
                        android:textSize="@dimen/text_size_xlarge"
                        android:textStyle="bold"
                        tools:text="₫32.000" />

                    <TextView
                        android:id="@+id/tv_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/define_dimen_8"
                        android:textColor="@color/priceStrikethrough"
                        android:textSize="@dimen/text_size_small"
                        tools:text="₫40.000" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/define_dimen_16"
                    android:layout_marginBottom="@dimen/define_dimen_16"
                    android:background="@color/neutral100" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/description_label"
                    android:textColor="@color/neutral900"
                    android:textSize="@dimen/text_size_normal"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_food_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/define_dimen_6"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/neutral600"
                    android:textSize="@dimen/text_size_small" />

                <TextView
                    android:id="@+id/tv_more_image_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/define_dimen_20"
                    android:text="@string/more_image_label"
                    android:textColor="@color/neutral900"
                    android:textSize="@dimen/text_size_normal"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcv_images"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/define_dimen_8"
                    android:focusable="false"
                    android:nestedScrollingEnabled="false" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/define_dimen_20"
                    android:layout_marginBottom="@dimen/define_dimen_12"
                    android:background="@color/neutral100" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/reviews_section_title"
                    android:textColor="@color/neutral900"
                    android:textSize="@dimen/text_size_normal"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/define_dimen_12"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_rate_food"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/define_dimen_44"
                        android:layout_marginEnd="@dimen/define_dimen_6"
                        android:layout_weight="1"
                        android:background="@drawable/bg_outlined_button"
                        android:gravity="center"
                        android:text="@string/action_rate_food"
                        android:textColor="@color/brandOrange"
                        android:textSize="@dimen/text_size_small"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_rate_restaurant"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/define_dimen_44"
                        android:layout_marginStart="@dimen/define_dimen_6"
                        android:layout_weight="1"
                        android:background="@drawable/bg_outlined_button"
                        android:gravity="center"
                        android:text="@string/action_rate_restaurant"
                        android:textColor="@color/brandOrange"
                        android:textSize="@dimen/text_size_small"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/define_dimen_8"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_view_food_reviews"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/define_dimen_40"
                        android:layout_marginEnd="@dimen/define_dimen_6"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/action_view_food_reviews"
                        android:textColor="@color/brandOrange"
                        android:textSize="@dimen/text_size_xsmall" />

                    <TextView
                        android:id="@+id/tv_view_restaurant_reviews"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/define_dimen_40"
                        android:layout_marginStart="@dimen/define_dimen_6"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/action_view_restaurant_reviews"
                        android:textColor="@color/brandOrange"
                        android:textSize="@dimen/text_size_xsmall" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
