<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screenBackground"
    android:orientation="vertical">

    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/define_dimen_12">

            <EditText
                android:id="@+id/edt_code"
                android:layout_width="match_parent"
                android:layout_height="@dimen/define_dimen_48"
                android:background="@drawable/bg_input_field"
                android:hint="@string/hint_promotion_code"
                android:paddingStart="@dimen/define_dimen_14"
                android:paddingEnd="@dimen/define_dimen_14"
                android:textAllCaps="true"
                android:textColorHint="@color/neutral400"
                android:textSize="@dimen/text_size_small" />

            <EditText
                android:id="@+id/edt_title"
                android:layout_width="match_parent"
                android:layout_height="@dimen/define_dimen_48"
                android:layout_marginTop="@dimen/define_dimen_8"
                android:background="@drawable/bg_input_field"
                android:hint="@string/promotion_title"
                android:paddingStart="@dimen/define_dimen_14"
                android:paddingEnd="@dimen/define_dimen_14"
                android:textColorHint="@color/neutral400"
                android:textSize="@dimen/text_size_small" />

            <EditText
                android:id="@+id/edt_discount_percent"
                android:layout_width="match_parent"
                android:layout_height="@dimen/define_dimen_48"
                android:layout_marginTop="@dimen/define_dimen_8"
                android:background="@drawable/bg_input_field"
                android:hint="@string/promotion_discount_percent"
                android:inputType="number"
                android:paddingStart="@dimen/define_dimen_14"
                android:paddingEnd="@dimen/define_dimen_14"
                android:textColorHint="@color/neutral400"
                android:textSize="@dimen/text_size_small" />

            <EditText
                android:id="@+id/edt_min_order"
                android:layout_width="match_parent"
                android:layout_height="@dimen/define_dimen_48"
                android:layout_marginTop="@dimen/define_dimen_8"
                android:background="@drawable/bg_input_field"
                android:hint="@string/promotion_min_order"
                android:inputType="number"
                android:paddingStart="@dimen/define_dimen_14"
                android:paddingEnd="@dimen/define_dimen_14"
                android:textColorHint="@color/neutral400"
                android:textSize="@dimen/text_size_small" />

            <EditText
                android:id="@+id/edt_max_discount"
                android:layout_width="match_parent"
                android:layout_height="@dimen/define_dimen_48"
                android:layout_marginTop="@dimen/define_dimen_8"
                android:background="@drawable/bg_input_field"
                android:hint="@string/promotion_max_discount"
                android:inputType="number"
                android:paddingStart="@dimen/define_dimen_14"
                android:paddingEnd="@dimen/define_dimen_14"
                android:textColorHint="@color/neutral400"
                android:textSize="@dimen/text_size_small" />

            <TextView
                android:id="@+id/tv_add_promotion"
                android:layout_width="match_parent"
                android:layout_height="@dimen/define_dimen_48"
                android:layout_marginTop="@dimen/define_dimen_14"
                android:background="@drawable/bg_primary_button"
                android:gravity="center"
                android:text="@string/add_promotion"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_normal"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcv_promotion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/define_dimen_12"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/define_dimen_12"
                android:gravity="center"
                android:padding="@dimen/define_dimen_16"
                android:text="@string/admin_promotions_empty"
                android:textColor="@color/textColorSecondary"
                android:textSize="@dimen/text_size_small"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
