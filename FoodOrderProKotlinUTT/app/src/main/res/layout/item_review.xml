<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/define_dimen_12"
    android:layout_marginEnd="@dimen/define_dimen_12"
    android:layout_marginBottom="@dimen/define_dimen_8"
    android:background="@drawable/bg_card_surface"
    android:orientation="horizontal"
    android:padding="@dimen/define_dimen_14"
    tools:ignore="ContentDescription">

    <de.hdodenhof.circleimageview.CircleImageView
        android:layout_width="@dimen/define_dimen_40"
        android:layout_height="@dimen/define_dimen_40"
        android:src="@drawable/ic_avatar_default"
        app:civ_border_color="@color/neutral100"
        app:civ_border_width="1dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/define_dimen_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_user"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/neutral900"
                android:textSize="@dimen/text_size_small"
                android:textStyle="bold"
                tools:text="Nguyễn Văn A" />

            <RatingBar
                android:id="@+id/rating_value"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:isIndicator="true"
                android:numStars="5"
                android:progressTint="@color/ratingStar"
                android:stepSize="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/define_dimen_6"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/neutral700"
            android:textSize="@dimen/text_size_small"
            tools:text="Món ăn ngon, giao nhanh, đóng gói cẩn thận!" />

        <TextView
            android:id="@+id/tv_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/define_dimen_6"
            android:textColor="@color/neutral400"
            android:textSize="@dimen/text_size_xsmall"
            tools:text="2 ngày trước" />
    </LinearLayout>
</LinearLayout>
