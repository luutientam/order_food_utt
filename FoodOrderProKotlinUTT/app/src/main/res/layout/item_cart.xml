<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/define_dimen_12"
    android:layout_marginEnd="@dimen/define_dimen_12"
    android:layout_marginTop="@dimen/define_dimen_8"
    android:background="@drawable/bg_card_surface"
    android:padding="@dimen/define_dimen_10"
    tools:ignore="ContentDescription">

    <androidx.cardview.widget.CardView
        android:id="@+id/layout_image"
        android:layout_width="@dimen/define_dimen_80"
        android:layout_height="@dimen/define_dimen_80"
        android:layout_centerVertical="true"
        app:cardCornerRadius="@dimen/define_dimen_10"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/img_food_cart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/neutral100"
            android:scaleType="centerCrop"
            tools:src="@drawable/img_no_image" />
    </androidx.cardview.widget.CardView>

    <!-- delete as a subtle icon top-right -->
    <ImageView
        android:id="@+id/tv_delete"
        android:layout_width="@dimen/define_dimen_28"
        android:layout_height="@dimen/define_dimen_28"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:padding="@dimen/define_dimen_4"
        android:src="@drawable/ic_delete"
        app:tint="@color/neutral400" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/define_dimen_80"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/define_dimen_12"
        android:layout_toEndOf="@+id/layout_image"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_food_name_cart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/define_dimen_30"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/app_name"
            android:textColor="@color/neutral900"
            android:textSize="@dimen/text_size_small"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_food_price_cart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/define_dimen_2"
            android:text="@string/app_name"
            android:textColor="@color/priceColor"
            android:textSize="@dimen/text_size_normal"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_subtract"
                android:layout_width="@dimen/define_dimen_28"
                android:layout_height="@dimen/define_dimen_28"
                android:background="@drawable/bg_stepper_button"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/label_sub"
                android:textColor="@color/neutral700"
                android:textSize="@dimen/text_size_xnormal"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_count"
                android:layout_width="@dimen/define_dimen_36"
                android:layout_height="@dimen/define_dimen_28"
                android:gravity="center"
                android:text="@string/label_quantity_1"
                android:textColor="@color/neutral900"
                android:textSize="@dimen/text_size_normal"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_add"
                android:layout_width="@dimen/define_dimen_28"
                android:layout_height="@dimen/define_dimen_28"
                android:background="@drawable/bg_stepper_button_primary"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/label_add"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_xnormal"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
